//@version=6
strategy("BTC Asymmetry 72 / 0.45 | 4H", overlay=true, initial_capital=10000, currency=currency.USD, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0, slippage=0, margin_long=100, margin_short=100, process_orders_on_close=false, calc_on_every_tick=false, calc_on_order_fills=false)

// ── Παράμετροι ──
window = input.int(72, "Παράθυρο ασυμμετρίας (κεριά 4H)", minval=2)
threshold = input.float(0.45, "Όριο εισόδου", minval=0.01, maxval=0.99, step=0.01)
riskPercent = input.float(1.0, "Σχεδιασμένο ρίσκο %", minval=0.1, maxval=100)

enableLong = input.bool(true, "Long")
enableShort = input.bool(true, "Short")

grpExit = "Έξοδοι"
stopMultiple = input.float(2.0, "Stop (x ATR)", minval=0.1, step=0.1, group=grpExit)
targetMultipleLong = input.float(10.0, "Target Long (x ATR)", minval=0.1, step=0.1, group=grpExit)
targetMultipleShort = input.float(3.0, "Target Short (x ATR)", minval=0.1, step=0.1, group=grpExit)
maximumHours = input.int(360, "Μέγιστη διάρκεια (ώρες) = κεριά x 4", minval=1, group=grpExit)
exitOnLostLong = input.bool(true, "Έξοδος Long όταν χάνεται η ασυμμετρία", group=grpExit)
exitOnLostShort = input.bool(true, "Έξοδος Short όταν χάνεται η ασυμμετρία", group=grpExit)

grpExtra = "Έξτρα (εκτός backtest, κλειστά)"
useTrendFilter = input.bool(false, "Φίλτρο τάσης (EMA)", group=grpExtra)
trendLength = input.int(200, "EMA περίοδος", minval=2, group=grpExtra)
useBreakeven = input.bool(false, "Μετακίνηση stop σε breakeven", group=grpExtra)
breakevenTrigger = input.float(1.5, "Ενεργοποίηση breakeven (x ATR)", minval=0.1, step=0.1, group=grpExtra)
showTable = input.bool(true, "Πίνακας πληροφοριών", group=grpExtra)

// ── Μόνο 4H ──
is4H = timeframe.in_seconds() == 14400

// ── Ασυμμετρία ανοδικής / καθοδικής ενέργειας ──
logReturn = math.log(close / close[1])

positiveReturn = math.max(logReturn, 0.0)
negativeReturn = math.min(logReturn, 0.0)

positiveEnergy = ta.sma(positiveReturn * positiveReturn, window)
negativeEnergy = ta.sma(negativeReturn * negativeReturn, window)

totalEnergy = positiveEnergy + negativeEnergy
asymmetry = totalEnergy > 0 ? (positiveEnergy - negativeEnergy) / totalEnergy : na

atrValue = ta.sma(ta.tr(true), 24)

trendEMA = ta.ema(close, trendLength)
trendOkLong = not useTrendFilter or close > trendEMA
trendOkShort = not useTrendFilter or close < trendEMA

// ── Σήματα εισόδου ──
crossLong = ta.crossover(asymmetry, threshold)
crossShort = ta.crossunder(asymmetry, -threshold)

ready = is4H and not na(asymmetry[1]) and not na(atrValue) and atrValue > 0

longSignal = ready and crossLong and trendOkLong
shortSignal = ready and crossShort and trendOkShort

var float entryATR = na
var bool beActive = false

if strategy.position_size == 0
    beActive := false

// ── Διαχείριση θέσεων ──
if barstate.isconfirmed and is4H
    if strategy.position_size != 0
        direction = strategy.position_size > 0 ? 1.0 : -1.0
        targetMult = direction > 0 ? targetMultipleLong : targetMultipleShort
        signedMove = direction * (close - strategy.position_avg_price)

        if useBreakeven and signedMove >= breakevenTrigger * entryATR
            beActive := true

        stopReached = beActive ? signedMove <= 0 : signedMove <= -stopMultiple * entryATR
        targetReached = signedMove >= targetMult * entryATR
        lostDirection = not na(asymmetry) and direction * asymmetry <= 0 and (direction > 0 ? exitOnLostLong : exitOnLostShort)

        entryTime = strategy.opentrades.entry_time(0)
        heldHours = (time_close - entryTime) / 3600000.0
        timeReached = heldHours >= maximumHours

        if stopReached or targetReached or timeReached or lostDirection
            reason = stopReached ? (beActive ? "Breakeven" : "Stop close") : targetReached ? "Target close" : timeReached ? "Time" : "Asymmetry"
            strategy.close_all(comment=reason)

    else if ready and strategy.equity > 0
        riskCash = strategy.equity * riskPercent / 100.0

        riskQuantity = riskCash / (stopMultiple * atrValue * syminfo.pointvalue)
        maxQuantity = strategy.equity / (close * syminfo.pointvalue)

        rawQuantity = math.min(riskQuantity, maxQuantity)
        quantity = math.floor(rawQuantity / syminfo.mincontract) * syminfo.mincontract

        if quantity > 0
            if enableLong and longSignal
                entryATR := atrValue
                strategy.entry("Long", strategy.long, qty=quantity)
            else if enableShort and shortSignal
                entryATR := atrValue
                strategy.entry("Short", strategy.short, qty=quantity)

// ── Εμφάνιση ──
inPosition = strategy.position_size != 0
positionDirection = strategy.position_size > 0 ? 1.0 : -1.0
activeTargetMult = positionDirection > 0 ? targetMultipleLong : targetMultipleShort

stopLevel = inPosition ? (beActive ? strategy.position_avg_price : strategy.position_avg_price - positionDirection * stopMultiple * entryATR) : na
targetLevel = inPosition ? strategy.position_avg_price + positionDirection * activeTargetMult * entryATR : na

plot(stopLevel, title="Stop στο κλείσιμο", color=color.red, linewidth=2, style=plot.style_linebr)
plot(targetLevel, title="Target στο κλείσιμο", color=color.lime, linewidth=2, style=plot.style_linebr)
plot(useTrendFilter ? trendEMA : na, title="Trend EMA", color=color.new(color.orange, 20))

bgcolor(strategy.position_size > 0 ? color.new(color.green, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na)

plotshape(longSignal, "Long signal", shape.triangleup, location.belowbar, color.green, size=size.tiny)
plotshape(shortSignal, "Short signal", shape.triangledown, location.abovebar, color.red, size=size.tiny)

plot(asymmetry, title="Asymmetry", display=display.data_window)

// ── Πίνακας πληροφοριών ──
var table info = table.new(position.top_right, 2, 4, border_width=1)
if showTable and barstate.islast
    table.cell(info, 0, 0, "Timeframe", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 1, 0, is4H ? "4H ✔" : "ΟΧΙ 4H – ανενεργό", text_color=color.white, bgcolor=is4H ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(info, 0, 1, "Asymmetry", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 1, 1, na(asymmetry) ? "-" : str.tostring(asymmetry, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 0, 2, "TP Long / Short", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 1, 2, str.tostring(targetMultipleLong, "#.0") + " / " + str.tostring(targetMultipleShort, "#.0") + " ATR", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 0, 3, "Θέση", text_color=color.white, bgcolor=color.new(color.gray, 30))
    table.cell(info, 1, 3, strategy.position_size > 0 ? "Long" : strategy.position_size < 0 ? "Short" : "Flat", text_color=color.white, bgcolor=color.new(color.gray, 30))

// ── Alerts ──
alertcondition(longSignal, "Long signal", "BTC Asymmetry: Long σήμα (4H)")
alertcondition(shortSignal, "Short signal", "BTC Asymmetry: Short σήμα (4H)")
